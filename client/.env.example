# ==============================================================================
# Cynbit Client Environment Variables (Vite + React)
# ==============================================================================
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put backend secrets (MONGODB_URI, GEMINI_API_KEY, JWT_SECRET, passwords) here.
#
# Backend API Base URL Configuration:
# - Local Development:
#   Leave empty to use the Vite dev server proxy at /api (proxies to http://localhost:5000),
#   or specify explicitly: VITE_API_URL=http://localhost:5000
#
# - Production Deployment (Vercel):
#   Set VITE_API_URL to your deployed Render backend service URL.
#   The client automatically appends /api and handles trailing slashes without duplicate /api/api paths.
#
# Example Production Value:
VITE_API_URL=https://cynbit-smart-project-hub.onrender.com

