PORT=5000
NODE_ENV=development

# MongoDB Atlas or local connection string (leave blank to run in-memory session DB for local dev):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cynbit?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Admin Authentication (Must be set in production):
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Admin Account Setup (Configured during initial server boot):
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=your_secure_admin_password_here

# Google Gemini API Key (Optional - robust intelligent deterministic fallback is used if empty or offline):
GEMINI_API_KEY=

# Allowed CORS Origin:
CLIENT_URL=http://localhost:3000
