PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (use database cynbit_hub):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mvkt0w5.mongodb.net/cynbit_hub?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Admin Authentication (Must be set in production):
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Admin Account Setup (Configured during initial server boot):
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=your_secure_admin_password_here

# Google Gemini API Key (Optional - robust intelligent deterministic fallback is used if empty or offline):
GEMINI_API_KEY=

# Google Gemini Model Configuration (Defaults to gemini-3.5-flash-lite with gemini-3.1-flash-lite fallback):
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed CORS Origin:
CLIENT_URL=http://localhost:3000
